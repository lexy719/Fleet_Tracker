# Get a key at https://developer.tomtom.com/ — enable Map Display, Routing, Traffic, Search, etc.
# Copy to .env.local (recommended) or .env — never commit real keys.
VITE_TOMTOM_API_KEY=

# Optional: override base URL for Search + Routing API fetch() calls.
# Leave unset: dev uses Vite proxy (/api/tomtom); production uses https://api.tomtom.com.
# Set if you proxy TomTom behind your own origin (e.g. static hosting without CORS to TomTom):
# VITE_TOMTOM_REST_BASE=/api/tomtom
