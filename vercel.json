{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *;"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/src/porto-dados/:path*",
      "destination": "https://dadosabertos.cm-porto.pt/:path*"
    },
    {
      "source": "/api/src/ip-alertas/:slug",
      "destination": "https://servicos.infraestruturasdeportugal.pt/pt-pt/alertas/rodovia/:slug"
    }
  ]
}
